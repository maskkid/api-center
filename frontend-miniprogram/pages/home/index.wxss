.container {
  padding: 32rpx;
}

.grid {}

.card { 
  text-align: center; 
}

/* 分享信息样式 */
.share-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  margin-bottom: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.share-code {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

.share-stats {
  font-size: 24rpx;
  color: #999;
}

/* 文案内容样式 */
.wenan-content {
  font-size: 32rpx;
  line-height: 1.6;
  color: #333;
  margin-bottom: 24rpx;
  white-space: pre-wrap;
  word-break: break-word;
}
