<view class="container">
  <view class="desc">精选文案</view>
  
  <!-- 文案列表 -->
  <block wx:for="{{items}}" wx:key="id">
    <view class="wenan-card">
      <view>{{item.text}}</view>
      <view class="image-grid">
        <block wx:for="{{item.images}}" wx:key="src">
          <image src="{{item}}" mode="aspectFill" bind:tap="onPreviewImage" data-src="{{item}}" />
        </block>
      </view>
      <view class="actions">
        <t-button
          t-class="action-button"
          variant="text"
          icon="download"
          bind:tap="onOneClickDownload"
          data-text="{{item.text}}"
          data-images="{{item.images}}"
        >一键下载</t-button>
      </view>
    </view>
  </block>
  
  <!-- 快速入口模块 -->
  <view class="title" style="margin-top: 32rpx;">快速入口</view>
  <t-grid column="{{4}}" border="{{false}}">
    <block wx:for="{{homeModules}}" wx:key="tag">
      <t-grid-item text="{{item.name}}" bind:click="onEnterModule" data-tag="{{item.tag}}">
        <t-icon name="{{item.icon}}" size="32px" />
      </t-grid-item>
    </block>
  </t-grid>
</view>
