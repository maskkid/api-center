/* 文案详情页样式 */
.container {
  padding: 32rpx;
  min-height: 100vh;
  background: #f5f5f5;
}

.wenan-detail-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 32rpx;
}

.content-text {
  font-size: 32rpx;
  line-height: 1.6;
  color: #333;
  margin-bottom: 32rpx;
  white-space: pre-wrap;
  word-break: break-word;
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.image-grid image {
  width: 100%;
  height: 200rpx;
  border-radius: 8rpx;
  object-fit: cover;
  background: #f0f0f0;
}

.actions {
  padding-top: 32rpx;
  border-top: 1rpx solid #f0f0f0;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 32rpx;
  color: #999;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  text-align: center;
}

/* 加载状态 */
.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 32rpx;
  color: #999;
  font-size: 28rpx;
}

/* 分享信息 */
.share-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  margin-bottom: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.share-code {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

.share-stats {
  font-size: 24rpx;
  color: #999;
}

/* 禁用状态提示 */
.disabled-notice {
  background: #fff3cd;
  border: 1rpx solid #ffeaa7;
  border-radius: 8rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 24rpx;
  text-align: center;
}

.disabled-notice text {
  color: #856404;
  font-size: 28rpx;
}