page {
  background-color: #f5f5f5;
}

.container {
  padding: 32rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.desc {
  font-size: 28rpx;
  color: #888;
  margin-bottom: 32rpx;
}

.user-card {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 32rpx;
  border-radius: 16rpx;
  margin-bottom: 32rpx;
}

.nickname {
  margin-left: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.wenan-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.08);
}

.actions {
  display: flex;
  justify-content: center;
  margin-top: 32rpx;
  padding-top: 32rpx;
  border-top: 1rpx solid #f0f0f0;
}

.action-button {
  background: #0052d9 !important;
  color: white !important;
  border-radius: 8rpx !important;
  padding: 16rpx 32rpx !important;
  font-size: 28rpx !important;
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 16rpx;
}

.image-grid image {
  width: 100%;
  height: 200rpx;
  border-radius: 8rpx;
}
